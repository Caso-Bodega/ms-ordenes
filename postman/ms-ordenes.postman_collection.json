{
  "info": {
    "_postman_id": "e5136995-59b0-506d-a9aa-70a20cab2e0f",
    "name": "BodegaNube - ms-ordenes",
    "description": "Ciclo de vida del pedido con reserva de stock. Requiere ms-ordenes y ms-inventario corriendo (docker compose up en bodeganube-infra). Ejecutar en orden (Run collection): prepara un producto en inventario, recibe un aviso con stock (LISTA_PARA_PICKING), prueba la idempotencia, un aviso sin stock (RECHAZADA_SIN_STOCK), el aislamiento por comercio, las transiciones de estado y la eliminacion.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Preparar: producto con stock en ms-inventario (201)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"sku\", \"ZAP-42-\" + (Date.now() % 100000));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Responde 201\", () => pm.response.to.have.status(201));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{inventarioUrl}}/api/v1/productos",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sku\": \"{{sku}}\",\n  \"nombre\": \"Zapatilla talla 42\",\n  \"stockDisponible\": 50\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Aviso con stock: queda LISTA_PARA_PICKING (201)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"externalOrderId\", \"shopify-\" + Date.now());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Responde 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"ordenId\", pm.response.json().id);",
              "pm.test(\"pm.response.json().estado === \\\"LISTA_PARA_PICKING\\\"\", () => pm.expect(pm.response.json().estado === \"LISTA_PARA_PICKING\").to.be.true);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/ordenes",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"externalOrderId\": \"{{externalOrderId}}\",\n  \"comercioId\": \"comercio-123\",\n  \"items\": [\n    {\n      \"productoId\": \"{{sku}}\",\n      \"cantidad\": 2\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Stock reservado en ms-inventario (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"pm.response.json().stockReservado === 2\", () => pm.expect(pm.response.json().stockReservado === 2).to.be.true);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{inventarioUrl}}/api/v1/productos/{{sku}}"
      }
    },
    {
      "name": "Reintento del mismo aviso: no duplica (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"pm.response.json().id == pm.collectionVariables.get(\\\"ordenId\\\")\", () => pm.expect(pm.response.json().id == pm.collectionVariables.get(\"ordenId\")).to.be.true);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/ordenes",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"externalOrderId\": \"{{externalOrderId}}\",\n  \"comercioId\": \"comercio-123\",\n  \"items\": [\n    {\n      \"productoId\": \"{{sku}}\",\n      \"cantidad\": 2\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Aviso sin items (400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Responde 400\", () => pm.response.to.have.status(400));",
              "pm.test(\"pm.response.json().detalles.items !== undefined\", () => pm.expect(pm.response.json().detalles.items !== undefined).to.be.true);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/ordenes",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"externalOrderId\": \"shopify-sin-items\",\n  \"comercioId\": \"comercio-123\",\n  \"items\": []\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Aviso de un producto sin stock: RECHAZADA_SIN_STOCK (201)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"externalOrderId2\", \"shopify-\" + Date.now() + \"-b\");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Responde 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"ordenId2\", pm.response.json().id);",
              "pm.test(\"pm.response.json().estado === \\\"RECHAZADA_SIN_STOCK\\\"\", () => pm.expect(pm.response.json().estado === \"RECHAZADA_SIN_STOCK\").to.be.true);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/ordenes",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"externalOrderId\": \"{{externalOrderId2}}\",\n  \"comercioId\": \"comercio-123\",\n  \"items\": [\n    {\n      \"productoId\": \"{{sku}}\",\n      \"cantidad\": 1\n    },\n    {\n      \"productoId\": \"NO-EXISTE\",\n      \"cantidad\": 1\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Compensacion: la reserva del otro item se libero (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"pm.response.json().stockReservado === 2\", () => pm.expect(pm.response.json().stockReservado === 2).to.be.true);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{inventarioUrl}}/api/v1/productos/{{sku}}"
      }
    },
    {
      "name": "Listar ordenes del comercio (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"pm.response.json().every(o => o.comercioId === \\\"comercio-123\\\")\", () => pm.expect(pm.response.json().every(o => o.comercioId === \"comercio-123\")).to.be.true);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/ordenes?comercioId=comercio-123"
      }
    },
    {
      "name": "Obtener orden por id (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"pm.response.json().items.length === 1\", () => pm.expect(pm.response.json().items.length === 1).to.be.true);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/ordenes/{{ordenId}}"
      }
    },
    {
      "name": "Otro comercio no ve la orden (404)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Responde 404\", () => pm.response.to.have.status(404));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Comercio-Id",
            "value": "comercio-ajeno"
          }
        ],
        "url": "{{baseUrl}}/api/v1/ordenes/{{ordenId}}"
      }
    },
    {
      "name": "Obtener orden inexistente (404)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Responde 404\", () => pm.response.to.have.status(404));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/ordenes/999999"
      }
    },
    {
      "name": "Ordenes disponibles para picking (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"pm.response.json().some(o => o.id == pm.collectionVariables.get(\\\"ordenId\\\"))\", () => pm.expect(pm.response.json().some(o => o.id == pm.collectionVariables.get(\"ordenId\"))).to.be.true);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/ordenes/disponibles-picking"
      }
    },
    {
      "name": "Editar items fuera de PENDIENTE_STOCK (409)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Responde 409\", () => pm.response.to.have.status(409));"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/ordenes/{{ordenId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"items\": [\n    {\n      \"productoId\": \"SKU-9\",\n      \"cantidad\": 1\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Reintentar reserva de una orden que no esta pendiente (409)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Responde 409\", () => pm.response.to.have.status(409));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/api/v1/ordenes/{{ordenId}}/reservar-stock"
      }
    },
    {
      "name": "Transicion de estado no permitida (409)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Responde 409\", () => pm.response.to.have.status(409));"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/ordenes/{{ordenId}}/estado",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"estado\": \"PENDIENTE_STOCK\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
